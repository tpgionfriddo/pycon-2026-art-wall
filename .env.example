# Copy to `.env` — Compose reads it automatically. `.env` is gitignored: it
# holds the moderator password. In production these are the Portainer stack's
# environment variables instead; nothing here is committed with a real value.

# Shared moderator password for /admin. The stack refuses to start without it.
ARTWALL_ADMIN_PASSWORD=change-me

# What the reverse proxy answers to, and the switch that turns TLS on. A bare
# domain makes Caddy obtain and renew a certificate for it automatically and
# redirect HTTP to HTTPS; a bare port serves plain HTTP and asks no
# certificate authority for anything. Keep the bare port hostless — the booth
# TV reaches a laptop by its address on the venue network, not as `localhost`.
#
#   ARTWALL_SITE_ADDRESS=artwall.example.com
ARTWALL_SITE_ADDRESS=:80

# Host ports the proxy publishes. They default to 80 and 443, which is what
# the VPS wants and what certificate issuance requires — the challenge
# arrives on port 80 of the domain. Overridden here because a laptop usually
# has something on 80 already. Nothing listens behind the HTTPS one until the
# site address above is a domain.
ARTWALL_HTTP_PORT=8000
ARTWALL_HTTPS_PORT=8443

# The HOST directory holding the database and the rendered media. It is
# bind-mounted in, so it outlives the containers. Inside them the path is
# always /data, which is what the application itself reads. On the VPS make
# this an absolute path outside the stack's own directory, so that redeploying
# — or deleting and recreating the stack — cannot take the database with it.
ARTWALL_DATA_DIR=./data

# The render worker's scratch area. Must be an ABSOLUTE path: it is
# bind-mounted onto itself so that the paths the worker hands the host daemon
# mean the same thing on both sides. The worker refuses to start otherwise.
ARTWALL_SCRATCH_DIR=/tmp/artwall-scratch

# How many submissions one client address may make per window. The default
# clears a hall: venue wifi puts every attendee behind one public address, so
# this counts addresses rather than people. Lower it if a single attendee
# floods the render queue. Restarting the server applies a new value and
# clears every bucket, because the counter is in-process.
ARTWALL_RATE_LIMIT_MAX=60
ARTWALL_RATE_LIMIT_WINDOW_S=600

# How deep the queue may get before /submit refuses, and the largest
# submission the server accepts.
ARTWALL_MAX_QUEUE_DEPTH=100
ARTWALL_MAX_CODE_BYTES=32768

# How long one render may take before the worker kills it. Raise this when
# good pieces are being killed: the slowest shipped Example takes about 15 s
# on one dedicated CPU, and a CPU-starved host can push that past 50 s.
# Do not remove the ceiling. It is the only thing bounding a submission that
# never finishes, the worker renders one job at a time, and a `rendering` row
# is handed straight back on restart, so an unbounded job stops the wall for
# the rest of the event and survives restarting the worker.
# Raising it also raises the wait for everybody queued behind a slow piece.
ARTWALL_RENDER_TIMEOUT_S=180

# How often the worker checks a queue it just found empty.
ARTWALL_POLL_INTERVAL_S=2.0

# The sandbox image the worker starts each job in, built by the
# `sandbox-image` service under this same tag.
ARTWALL_WORKER_IMAGE=artwall-worker

# The host daemon's socket. Docker Desktop users whose default socket is not
# exposed can point this at ~/.docker/run/docker.sock instead.
ARTWALL_DOCKER_SOCK=/var/run/docker.sock
