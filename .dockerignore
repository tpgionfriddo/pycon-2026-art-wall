# Build context for both images, which share the repo root: the application
# image (Dockerfile) needs pyproject.toml, uv.lock and artwall/; the sandbox
# image (worker/Dockerfile) needs only samples/preview.py and
# worker/render_job.py. The sample media alone is ~46 MB that no build ever
# uses, so keep it out.

.git/
.venv/
__pycache__/
*.py[co]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Runtime state — database, rendered media, contact data. Never in an image.
data/

# Sample art: keep the render harness, drop the rendered media and the pieces.
samples/*
!samples/preview.py

# Nothing below is used at runtime by any image.
.idea/
.junie/
.scratch/
docs/
prototypes/
tests/
models/
*.ipynb
*.md
